<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. API 라우팅
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]
    RewriteRule ^api$ api/index.php [QSA,L]

    # 2. 존재하는 파일/디렉토리 제공
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. SPA 프론트엔드 라우팅
    RewriteRule ^ index.html [L]
</IfModule>
