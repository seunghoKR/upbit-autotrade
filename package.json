{
  "name": "upbit-auto-trading-system",
  "version": "2.8.0",
  "description": "Upbit Automated Trading Bot with Telegram Approval & Modern React Dashboard",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "dashboard": "npm run dev --prefix dashboard",
    "build": "npm run build --prefix dashboard",
    "deploy": "npm run build --prefix dashboard && node deploy_ftp.js",
    "dev": "concurrently \"npm run server\" \"npm run dashboard\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "technicalindicators": "^3.1.0",
    "uuid": "^11.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "localtunnel": "^2.0.2",
    "nodemon": "^3.1.9"
  }
}
